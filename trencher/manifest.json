{
  "manifest_version": 3,
  "name": "Meme Trencher (Paper)",
  "version": "0.9.6",
  "description": "Paper trading desk for Solana meme coins (Scout, Compounder, Risk, 24/7 view). Fake money only, never touches a wallet.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*",
    "https://api.rugcheck.xyz/*",
    "https://solana-rpc.publicnode.com/*",
    "https://www.reddit.com/*",
    "https://oauth.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "copy.html"
  },
  "action": {
    "default_title": "Meme Trencher öffnen"
  }
}
