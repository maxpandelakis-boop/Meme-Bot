{
  "manifest_version": 3,
  "name": "Meme Trencher (Paper)",
  "version": "0.9.0",
  "description": "Paper copy-trading bot for Solana meme coins: mirrors traders you follow with fake money. Never touches a wallet.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://fomo.family/*",
    "https://*.fomo.family/*",
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*",
    "https://api.rugcheck.xyz/*",
    "https://solana-rpc.publicnode.com/*",
    "https://www.reddit.com/*",
    "https://oauth.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "copy.html"
  },
  "action": {
    "default_title": "Meme Trencher öffnen"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "fomo.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
