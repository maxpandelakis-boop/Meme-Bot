{
  "manifest_version": 3,
  "name": "Meme Trencher (Paper)",
  "version": "0.3.0",
  "description": "Live Solana meme coin trades in a side panel, with fake-money buy and sell. Never touches a wallet.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://fomo.family/*",
    "https://*.fomo.family/*",
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Meme Trencher öffnen"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "fomo.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
